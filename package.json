{
  "name": "inkmark",
  "version": "0.1.10",
  "description": "InkMark",
  "repository": "https://github.com/lvtian-bot/InkMark",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node -e \"fs.rmSync('out', { force: true, recursive: true })\" && electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "node -e \"fs.rmSync('out', { force: true, recursive: true })\" && electron-vite build && electron-builder --win",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@milkdown/kit": "^7.22.0",
    "@milkdown/plugin-block": "^7.22.0",
    "@milkdown/plugin-clipboard": "^7.22.0",
    "@milkdown/plugin-listener": "^7.22.0",
    "@milkdown/plugin-prism": "^7.22.0",
    "@milkdown/plugin-upload": "^7.22.0",
    "@milkdown/react": "^7.22.0",
    "@milkdown/theme-nord": "^7.22.0",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.9",
    "github-markdown-css": "^5.9.0",
    "lucide-react": "^1.30.0",
    "prosemirror-state": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-frontmatter": "^5.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^43.3.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.66.0",
    "unified": "^11.0.5",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.inkmark.app",
    "productName": "InkMark",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "lvtian-bot",
        "repo": "InkMark"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "InkMark",
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "InkMark.Markdown",
        "role": "Editor",
        "description": "InkMark Markdown 文档",
        "icon": "build/fileicon-md.ico"
      },
      {
        "ext": "markdown",
        "name": "InkMark.Markdown",
        "role": "Editor",
        "description": "InkMark Markdown 文档",
        "icon": "build/fileicon-md.ico"
      }
    ]
  }
}
